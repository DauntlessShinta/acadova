PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_long_random_jwt_secret

# Verification links sent by email. Use the local Vite URL in development;
# Render production must use https://acadova-ze91.onrender.com.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Browser origin permitted by CORS. Keep separate from FRONTEND_URL.
FRONTEND_ORIGIN=http://localhost:5173
# Optional push delivery. The REST key stays on the backend only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Random backend-only secret (32+ chars) for opaque per-user push aliases.
ONESIGNAL_IDENTITY_SECRET=
# Server-owned reminder/cooldown policy (minutes).
MESSAGE_PUSH_COOLDOWN_MINUTES=5
UNREAD_REMINDER_MINUTES=30
SESSION_REMINDER_MINUTES=45
# Use a Brevo transactional API key and a sender verified in Brevo.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=Acadova <your_verified_sender@example.com>
# Legacy SMTP settings are no longer used for verification email delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_sender@gmail.com
MAIL_APP_PASSWORD=your_google_app_password
