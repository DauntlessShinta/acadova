PORT=5000
MONGO_URI=your_mongodb_atlas_connection_string
# Optional DNS override for environments where Node cannot resolve MongoDB Atlas SRV records.
DNS_SERVERS=
JWT_SECRET=your_long_random_jwt_secret

# Verification links sent by email. Use the local Vite URL in development;
# Render production must use https://acadova-ze91.onrender.com.
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Browser origin permitted by CORS. Keep separate from FRONTEND_URL.
FRONTEND_ORIGIN=http://localhost:5173
# Google Identity Services web OAuth client ID (same public ID in Vite and backend).
GOOGLE_CLIENT_ID=
# Optional push delivery. The REST key stays on the backend only.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Random backend-only secret (32+ chars) for opaque per-user push aliases.
ONESIGNAL_IDENTITY_SECRET=
# Server-owned reminder/cooldown policy (minutes).
MESSAGE_PUSH_COOLDOWN_MINUTES=5
UNREAD_REMINDER_MINUTES=30
SESSION_REMINDER_MINUTES=45
# Use a Brevo transactional API key and a sender verified in Brevo.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM=Acadova <your_verified_sender@example.com>
# Legacy SMTP settings are no longer used for verification email delivery.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=your_sender@gmail.com
MAIL_APP_PASSWORD=your_google_app_password

# Backend-only Gemini. Keep disabled until owner approval of release/provider charges.
# Real authorized materials: ENABLED=true, LOCAL_QA=false (development/production).
# Deterministic tests/local synthetic fixtures: LOCAL_QA=true (never production).
# Never expose GEMINI_API_KEY through VITE_ variables. There is no mock fallback.
AI_STUDY_ENABLED=false
AI_STUDY_LOCAL_QA=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_STUDY_MAX_BYTES=5242880
AI_STUDY_MAX_PAGES=20
AI_STUDY_MAX_SLIDES=30
AI_STUDY_MAX_CHARS=30000
AI_STUDY_MAX_CARDS=10
AI_STUDY_MAX_QUESTIONS=5
AI_STUDY_DAILY_LIMIT=3
AI_STUDY_MAX_SETS=30
AI_STUDY_TIMEOUT_MS=60000

# New self-service Student registrations only. Exact ASCII domains, no wildcards.
# Initial project-owner approval only; further domains need institutional approval.
STUDENT_EMAIL_DOMAINS=phinmaed.com

# Staff MFA is source-gated OFF. These settings do not activate enforcement.
# Independently generate a backend-only 32-64 byte random key (64-128 hex chars).
# Provision securely only under the staff MFA activation/recovery runbook.
STAFF_MFA_HMAC_KEY=

# Free tutoring / EXP activation requires a separately reviewed source release,
# legacy-obligation reconciliation, verified indexes, backup/restore and approval.
# No environment variable enables either production source gate.
# Optional EXP policy defaults; EXP is recognition, never tutoring payment.
EXP_ASSESSMENT_AMOUNT=20
EXP_TUTORING_AMOUNT=50
EXP_MINIMUM_TUTORING_MINUTES=15
EXP_REPORT_WINDOW_HOURS=48
EXP_DAILY_AWARDS=5
EXP_WEEKLY_AWARDS=20
EXP_TUTORING_DAILY_AWARDS=2
EXP_TUTORING_WEEKLY_AWARDS=8
EXP_PAIR_DAILY_AWARDS=1
EXP_PAIR_WEEKLY_AWARDS=2

# Separate Acadi provider approval. Keep false pending owner/provider review.
# Personal context has an additional source gate; consent cannot enable it alone.
ACADI_GEMINI_ENABLED=false
ACADI_AUDIENCE_APPROVED=false
ACADI_GEMINI_MODEL=gemini-3.5-flash-lite

# Disabled by default. Only operator-verified immediate proxy IP/CIDR allowlist.
TRUST_PROXY_CIDRS=
