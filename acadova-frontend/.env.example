# API origin only: requests already include /api in their paths.
# Set this to the public HTTPS backend origin in Render before building.
VITE_API_URL=https://your-public-backend.onrender.com
# Public OneSignal App ID only. Never place the REST API key in Vite variables.
VITE_ONESIGNAL_APP_ID=
# Public Google Identity Services web OAuth client ID; same value as backend GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
